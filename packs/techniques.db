{"_id": "pCY1WOmGv7qXGFe8", "name": "Honest Face", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Persuasion", "tier": "Adept", "cost": "", "description": "<p><b>Persuasion \u2014 Adept.</b> +20 to be believed when you are, in fact, telling the truth.</p>"}, "flags": {"blightmarch": {"skill": "Persuasion", "tier": "Adept"}}}
{"_id": "zltad0McTMndwH4Z", "name": "The Turned Room", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Persuasion", "tier": "Master", "cost": "", "description": "<p><b>Persuasion \u2014 Master.</b> 1/session, when you win a social exchange, sway a second undecided listener.</p>"}, "flags": {"blightmarch": {"skill": "Persuasion", "tier": "Master"}}}
{"_id": "ZHZJ16qdxMxF7vg5", "name": "Kingmaker", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Persuasion", "tier": "Master", "cost": "", "description": "<p><b>Persuasion \u2014 Master.</b> on a Masterstroke before a group, move the whole room's Regard one step.</p>"}, "flags": {"blightmarch": {"skill": "Persuasion", "tier": "Master"}}}
