{"_id": "MxsXb4RpuxzQVWIk", "name": "Reputation Precedes", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Intimidation", "tier": "Adept", "cost": "", "description": "<p><b>Intimidation \u2014 Adept.</b> 1/session, a foe who's heard of you begins the scene already Shaken.</p>"}, "flags": {"blightmarch": {"skill": "Intimidation", "tier": "Adept"}}}
{"_id": "wiZnBKJxBbF0ZZFx", "name": "Name Your Fear", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Intimidation", "tier": "Master", "cost": "", "description": "<p><b>Intimidation \u2014 Master.</b> 2 Resolve: impose your Presence Bonus as a Fear rating on one target.</p>"}, "flags": {"blightmarch": {"skill": "Intimidation", "tier": "Master"}}}
{"_id": "2fd4LeB8QCvidHlE", "name": "Break the Line", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Intimidation", "tier": "Master", "cost": "", "description": "<p><b>Intimidation \u2014 Master.</b> on a Masterstroke vs a group, force an immediate Morale check at \u221220.</p>"}, "flags": {"blightmarch": {"skill": "Intimidation", "tier": "Master"}}}
{"_id": "VDMcd0FOXUnYYMqg", "name": "Straight Face", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Deception", "tier": "Adept", "cost": "", "description": "<p><b>Deception \u2014 Adept.</b> on a Masterstroke, an Insight Reckoning against this lie fails automatically.</p>"}, "flags": {"blightmarch": {"skill": "Deception", "tier": "Adept"}}}
{"_id": "FHo2ce0pkFpxBE6R", "name": "Quick Cover", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Deception", "tier": "Adept", "cost": "", "description": "<p><b>Deception \u2014 Adept.</b> invent a plausible alias, story, or excuse with no time to prepare.</p>"}, "flags": {"blightmarch": {"skill": "Deception", "tier": "Adept"}}}
{"_id": "mrLpkUlMNKaPVYbZ", "name": "The Long Con", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Deception", "tier": "Master", "cost": "", "description": "<p><b>Deception \u2014 Master.</b> bank a Deception Masterstroke as an established fact to spend later.</p>"}, "flags": {"blightmarch": {"skill": "Deception", "tier": "Master"}}}
{"_id": "mumYHqLBvykJ01uf", "name": "False Colors", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Deception", "tier": "Master", "cost": "", "description": "<p><b>Deception \u2014 Master.</b> maintain a full assumed identity indefinitely; only a Masterstroke or hard proof cracks it.</p>"}, "flags": {"blightmarch": {"skill": "Deception", "tier": "Master"}}}
