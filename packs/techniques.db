{"_id": "YJ45ucGmCp2FmAAE", "name": "Pinning Cast", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Thrown Weapons", "tier": "Master", "cost": "", "description": "<p><b>Thrown Weapons \u2014 Master.</b> on a Masterstroke, the struck limb is pinned to terrain.</p>"}, "flags": {"blightmarch": {"skill": "Thrown Weapons", "tier": "Master"}}}
{"_id": "4bsFUFYpNhYOO3da", "name": "Fan of Blades", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Thrown Weapons", "tier": "Master", "cost": "", "description": "<p><b>Thrown Weapons \u2014 Master.</b> 2 Stamina: throw three knives at three foes at \u221210 each.</p>"}, "flags": {"blightmarch": {"skill": "Thrown Weapons", "tier": "Master"}}}
{"_id": "VyEPyM5dOQpE6Vzg", "name": "Shield Wall", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Shield Craft", "tier": "Adept", "cost": "", "description": "<p><b>Shield Craft \u2014 Adept.</b> allies at Reach gain +5 to defenses while your shield holds.</p>"}, "flags": {"blightmarch": {"skill": "Shield Craft", "tier": "Adept"}}}
{"_id": "SiFSWjDzL9exMaGq", "name": "Shield Bash", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Shield Craft", "tier": "Adept", "cost": "", "description": "<p><b>Shield Craft \u2014 Adept.</b> 1 Stamina: after a Parry, a free Crushing 1d4 that may stagger.</p>"}, "flags": {"blightmarch": {"skill": "Shield Craft", "tier": "Adept"}}}
{"_id": "5cJxoAwVdP0RqSJy", "name": "Bulwark", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Shield Craft", "tier": "Master", "cost": "", "description": "<p><b>Shield Craft \u2014 Master.</b> 1/round, negate one hit on you or an ally at Reach; shield takes a notch.</p>"}, "flags": {"blightmarch": {"skill": "Shield Craft", "tier": "Master"}}}
{"_id": "xnXFzcDLSQdnumSA", "name": "Immovable", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Shield Craft", "tier": "Master", "cost": "", "description": "<p><b>Shield Craft \u2014 Master.</b> you cannot be driven back, knocked prone, or moved against your will while braced.</p>"}, "flags": {"blightmarch": {"skill": "Shield Craft", "tier": "Master"}}}
{"_id": "jgCmcblAJFvJrxj9", "name": "True Quench", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Blacksmithing", "tier": "Adept", "cost": "", "description": "<p><b>Blacksmithing \u2014 Adept.</b> your Harden step takes no penalty.</p>"}, "flags": {"blightmarch": {"skill": "Blacksmithing", "tier": "Adept"}}}
{"_id": "R7xZkZsCHiSkA1Qp", "name": "Cold Read", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Blacksmithing", "tier": "Adept", "cost": "", "description": "<p><b>Blacksmithing \u2014 Adept.</b> inspect any blade to learn its grade, Virtues, and Flaws before buying or fighting it.</p>"}, "flags": {"blightmarch": {"skill": "Blacksmithing", "tier": "Adept"}}}
{"_id": "mXmLgrtKb5gsyWvM", "name": "Read the Grain", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Blacksmithing", "tier": "Master", "cost": "", "description": "<p><b>Blacksmithing \u2014 Master.</b> re-roll one Failure per project.</p>"}, "flags": {"blightmarch": {"skill": "Blacksmithing", "tier": "Master"}}}
{"_id": "vfGyRmSvkTtp9f7r", "name": "Signature Steel", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Blacksmithing", "tier": "Master", "cost": "", "description": "<p><b>Blacksmithing \u2014 Master.</b> items you forge carry your maker's mark; their Deeds build your Renown faster.</p>"}, "flags": {"blightmarch": {"skill": "Blacksmithing", "tier": "Master"}}}
{"_id": "kWING1ADWnRKj7NE", "name": "Sound Joint", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Carpentry", "tier": "Adept", "cost": "", "description": "<p><b>Carpentry \u2014 Adept.</b> your constructions hold one durability grade above their wood.</p>"}, "flags": {"blightmarch": {"skill": "Carpentry", "tier": "Adept"}}}
{"_id": "StPNaLxqeWltXkPT", "name": "Rapid Frame", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Carpentry", "tier": "Adept", "cost": "", "description": "<p><b>Carpentry \u2014 Adept.</b> halve the time to build fortifications, rafts, and siege works.</p>"}, "flags": {"blightmarch": {"skill": "Carpentry", "tier": "Adept"}}}
