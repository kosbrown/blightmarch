{"_id": "5u2QjkdQkUolhtCY", "name": "Local Knowledge", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Streetwise", "tier": "Adept", "cost": "", "description": "<p><b>Streetwise \u2014 Adept.</b> arrive in any town already knowing its powers, dangers, and grudges.</p>"}, "flags": {"blightmarch": {"skill": "Streetwise", "tier": "Adept"}}}
{"_id": "Q5kaG4qYytSBYChK", "name": "The Whisper Network", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Streetwise", "tier": "Master", "cost": "", "description": "<p><b>Streetwise \u2014 Master.</b> on a Masterstroke, plant a rumor that reaches a faction by next Season Turn.</p>"}, "flags": {"blightmarch": {"skill": "Streetwise", "tier": "Master"}}}
{"_id": "TqoNd6Fkp1Y6M7as", "name": "Underworld Standing", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Streetwise", "tier": "Master", "cost": "", "description": "<p><b>Streetwise \u2014 Master.</b> call in a favor from the criminal element once per settlement.</p>"}, "flags": {"blightmarch": {"skill": "Streetwise", "tier": "Master"}}}
{"_id": "FnKis4NF7bmAn0bK", "name": "Never Lost the Trail", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Tracking", "tier": "Adept", "cost": "", "description": "<p><b>Tracking \u2014 Adept.</b> a Costly Success follows the trail anyway; the cost is time.</p>"}, "flags": {"blightmarch": {"skill": "Tracking", "tier": "Adept"}}}
{"_id": "cFJrVuox8tfu6HGq", "name": "Counter-Track", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Tracking", "tier": "Adept", "cost": "", "description": "<p><b>Tracking \u2014 Adept.</b> cover your party's trail so well that pursuers roll at \u221220.</p>"}, "flags": {"blightmarch": {"skill": "Tracking", "tier": "Adept"}}}
{"_id": "D99bGifGHvopVihG", "name": "Backtrack", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Tracking", "tier": "Master", "cost": "", "description": "<p><b>Tracking \u2014 Master.</b> on a Masterstroke, read a trail's past: number, weight, age, and what they feared.</p>"}, "flags": {"blightmarch": {"skill": "Tracking", "tier": "Master"}}}
{"_id": "16hYl8bN8Ddc4hU1", "name": "The Long Hunt", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Tracking", "tier": "Master", "cost": "", "description": "<p><b>Tracking \u2014 Master.</b> once locked onto a quarry, you always know its rough direction until you rest.</p>"}, "flags": {"blightmarch": {"skill": "Tracking", "tier": "Master"}}}
{"_id": "KrEyTJrasnR8U99g", "name": "Killing Blow", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Hunting", "tier": "Adept", "cost": "", "description": "<p><b>Hunting \u2014 Adept.</b> on a Masterstroke vs a beast, the first hit lands as Grievous if it wounds.</p>"}, "flags": {"blightmarch": {"skill": "Hunting", "tier": "Adept"}}}
{"_id": "UgYIFZLza9zcxcVV", "name": "Patient Blind", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Hunting", "tier": "Adept", "cost": "", "description": "<p><b>Hunting \u2014 Adept.</b> set an ambush that grants the whole party +20 to their first strikes.</p>"}, "flags": {"blightmarch": {"skill": "Hunting", "tier": "Adept"}}}
{"_id": "Yj4ygfuhA66w7Ia4", "name": "Clean Harvest", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Hunting", "tier": "Master", "cost": "", "description": "<p><b>Hunting \u2014 Master.</b> on a Masterstroke, a harvest yields one extra part or one grade finer.</p>"}, "flags": {"blightmarch": {"skill": "Hunting", "tier": "Master"}}}
{"_id": "H1NKLe9lc977k9gg", "name": "Master of the Hunt", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Hunting", "tier": "Master", "cost": "", "description": "<p><b>Hunting \u2014 Master.</b> you know each season what a region's game Dials will bear without collapse.</p>"}, "flags": {"blightmarch": {"skill": "Hunting", "tier": "Master"}}}
{"_id": "ZanOIDS2iK9lEt2I", "name": "Nimble Fingers", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Larceny", "tier": "Adept", "cost": "", "description": "<p><b>Larceny \u2014 Adept.</b> pick a common lock or lift a purse with no roll when unwatched.</p>"}, "flags": {"blightmarch": {"skill": "Larceny", "tier": "Adept"}}}
{"_id": "rSCvk9IA98e8f9UF", "name": "Trapwise", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Larceny", "tier": "Adept", "cost": "", "description": "<p><b>Larceny \u2014 Adept.</b> spot and disarm mundane traps and alarms on sight.</p>"}, "flags": {"blightmarch": {"skill": "Larceny", "tier": "Adept"}}}
