{"_id": "J6lCiue2ES2EFObA", "name": "Chokehold", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Unarmed & Grappling", "tier": "Master", "cost": "", "description": "<p><b>Unarmed & Grappling \u2014 Master.</b> a held foe must pass Endurance\u00d75 each round or fall unconscious.</p>"}, "flags": {"blightmarch": {"skill": "Unarmed & Grappling", "tier": "Master"}}}
