{"_id": "FdacYDtT9vzn5MNe", "name": "Second Wind", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Athletics", "tier": "Adept", "cost": "", "description": "<p><b>Athletics \u2014 Adept.</b> 1/scene, spend no Stamina on an action that would cost it.</p>"}, "flags": {"blightmarch": {"skill": "Athletics", "tier": "Adept"}}}
{"_id": "PINhVBN7zqLap8Hi", "name": "Sure Grip", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Athletics", "tier": "Adept", "cost": "", "description": "<p><b>Athletics \u2014 Adept.</b> you never fall from a climb on a Costly Success; the cost is time.</p>"}, "flags": {"blightmarch": {"skill": "Athletics", "tier": "Adept"}}}
{"_id": "Hb3xFOfYarqoKd1z", "name": "Unstoppable", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Athletics", "tier": "Master", "cost": "", "description": "<p><b>Athletics \u2014 Master.</b> on a Masterstroke, ignore difficult terrain and the first prone/Off-Balance this scene.</p>"}, "flags": {"blightmarch": {"skill": "Athletics", "tier": "Master"}}}
{"_id": "G9Ok91MbA3665MYq", "name": "Iron Frame", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Athletics", "tier": "Master", "cost": "", "description": "<p><b>Athletics \u2014 Master.</b> once per fight, shrug a Crushing Grievous Wound down to an ordinary Wound.</p>"}, "flags": {"blightmarch": {"skill": "Athletics", "tier": "Master"}}}
{"_id": "EVySixUj10KgfIAa", "name": "Cat's Landing", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Acrobatics", "tier": "Adept", "cost": "", "description": "<p><b>Acrobatics \u2014 Adept.</b> take no damage from a fall of Near or less; halve greater falls.</p>"}, "flags": {"blightmarch": {"skill": "Acrobatics", "tier": "Adept"}}}
{"_id": "3xgG21uuLkshKFEQ", "name": "Tumbler's Guard", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Acrobatics", "tier": "Adept", "cost": "", "description": "<p><b>Acrobatics \u2014 Adept.</b> you may Dodge attacks from foes you can't see.</p>"}, "flags": {"blightmarch": {"skill": "Acrobatics", "tier": "Adept"}}}
{"_id": "oZIJioFDZCVPBw9L", "name": "Impossible Line", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Acrobatics", "tier": "Master", "cost": "", "description": "<p><b>Acrobatics \u2014 Master.</b> on a Masterstroke, cross a space a foe controls without a free attack.</p>"}, "flags": {"blightmarch": {"skill": "Acrobatics", "tier": "Master"}}}
{"_id": "uyqAnuaaKZzJZJ0Y", "name": "Wall-Runner", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Acrobatics", "tier": "Master", "cost": "", "description": "<p><b>Acrobatics \u2014 Master.</b> traverse sheer or moving surfaces for a few seconds as if they were ground.</p>"}, "flags": {"blightmarch": {"skill": "Acrobatics", "tier": "Master"}}}
{"_id": "1gcAhP4U3pGbmayz", "name": "Ghost-Step", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Stealth", "tier": "Adept", "cost": "", "description": "<p><b>Stealth \u2014 Adept.</b> stay hidden after a Costly Success that would reveal you, at the cost of your next action.</p>"}, "flags": {"blightmarch": {"skill": "Stealth", "tier": "Adept"}}}
{"_id": "P3I3qu9SeuZDWqPc", "name": "Blend", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Stealth", "tier": "Adept", "cost": "", "description": "<p><b>Stealth \u2014 Adept.</b> in a crowd or wilderness, become effectively unfindable without magic or a Masterstroke.</p>"}, "flags": {"blightmarch": {"skill": "Stealth", "tier": "Adept"}}}
{"_id": "psaFssIeIgoGE4C1", "name": "Second Skin", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Stealth", "tier": "Master", "cost": "", "description": "<p><b>Stealth \u2014 Master.</b> on a Masterstroke, a fooled watcher stays fooled the whole scene.</p>"}, "flags": {"blightmarch": {"skill": "Stealth", "tier": "Master"}}}
{"_id": "LzyBBgAxALoFjoFA", "name": "The Quiet Kill", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Stealth", "tier": "Master", "cost": "", "description": "<p><b>Stealth \u2014 Master.</b> an attack from hiding on an unaware foe is automatically Grievous (already true) and silent.</p>"}, "flags": {"blightmarch": {"skill": "Stealth", "tier": "Master"}}}
{"_id": "OIH8qPHSPmOW7SAy", "name": "Living Off the Land", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Wilderness Survival", "tier": "Adept", "cost": "", "description": "<p><b>Wilderness Survival \u2014 Adept.</b> provision yourself and one other indefinitely in known terrain.</p>"}, "flags": {"blightmarch": {"skill": "Wilderness Survival", "tier": "Adept"}}}
{"_id": "07i1dDN7rmRNkoDY", "name": "Weather-Wise", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Wilderness Survival", "tier": "Adept", "cost": "", "description": "<p><b>Wilderness Survival \u2014 Adept.</b> read the coming day's weather; never caught unsheltered by surprise.</p>"}, "flags": {"blightmarch": {"skill": "Wilderness Survival", "tier": "Adept"}}}
{"_id": "bYR85dzESiZkFZ5c", "name": "Read the Sky", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Wilderness Survival", "tier": "Master", "cost": "", "description": "<p><b>Wilderness Survival \u2014 Master.</b> on a Masterstroke, learn the next day's weather and gain +20 to act on it.</p>"}, "flags": {"blightmarch": {"skill": "Wilderness Survival", "tier": "Master"}}}
{"_id": "Ql3IkJ6AKwQjpe5N", "name": "Trailmaster", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Wilderness Survival", "tier": "Master", "cost": "", "description": "<p><b>Wilderness Survival \u2014 Master.</b> you and your party ignore the first Condition of any journey through wild land.</p>"}, "flags": {"blightmarch": {"skill": "Wilderness Survival", "tier": "Master"}}}
{"_id": "d6Qi6IGrtNYHZE1m", "name": "As One", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Riding", "tier": "Adept", "cost": "", "description": "<p><b>Riding \u2014 Adept.</b> your mount acts on your Initiative and never panics from Fear below \u221220.</p>"}, "flags": {"blightmarch": {"skill": "Riding", "tier": "Adept"}}}
{"_id": "Xka4rxYPQAjQuDYH", "name": "Trick Rider", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Riding", "tier": "Adept", "cost": "", "description": "<p><b>Riding \u2014 Adept.</b> fight, shoot, or leap from the saddle with no penalty.</p>"}, "flags": {"blightmarch": {"skill": "Riding", "tier": "Adept"}}}
{"_id": "Ss2d2QYfs3N5thTA", "name": "The Long Gallop", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Riding", "tier": "Master", "cost": "", "description": "<p><b>Riding \u2014 Master.</b> on a Masterstroke, double travel distance for a day without tiring the beast.</p>"}, "flags": {"blightmarch": {"skill": "Riding", "tier": "Master"}}}
{"_id": "ERxY7dGhcRgfmvhG", "name": "War-Trained", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Riding", "tier": "Master", "cost": "", "description": "<p><b>Riding \u2014 Master.</b> your mount fights as a partner: its hooves are your second attack in a melee.</p>"}, "flags": {"blightmarch": {"skill": "Riding", "tier": "Master"}}}
{"_id": "xIzm5g9lCmFs2KXm", "name": "I Have Read of This", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: History", "tier": "Adept", "cost": "", "description": "<p><b>Lore: History \u2014 Adept.</b> 1/session, ask the GM one true fact about an institution, bloodline, or power.</p>"}, "flags": {"blightmarch": {"skill": "Lore: History", "tier": "Adept"}}}
{"_id": "jMuS7dJ4iEHmImia", "name": "Genealogist", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: History", "tier": "Adept", "cost": "", "description": "<p><b>Lore: History \u2014 Adept.</b> trace any noble or guild line; know its debts, feuds, and skeletons.</p>"}, "flags": {"blightmarch": {"skill": "Lore: History", "tier": "Adept"}}}
{"_id": "wlVSQmpYlLxNAWQK", "name": "Precedent", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: History", "tier": "Master", "cost": "", "description": "<p><b>Lore: History \u2014 Master.</b> on a Masterstroke in a formal setting, cite history to cancel the Rig for that contest.</p>"}, "flags": {"blightmarch": {"skill": "Lore: History", "tier": "Master"}}}
{"_id": "cOSeaGpZGXVoAb9X", "name": "The Long View", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: History", "tier": "Master", "cost": "", "description": "<p><b>Lore: History \u2014 Master.</b> once per session, know how a faction has behaved in this exact situation before.</p>"}, "flags": {"blightmarch": {"skill": "Lore: History", "tier": "Master"}}}
{"_id": "9d7sUbJ0JohrDsC0", "name": "Forager's Eye", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: Nature", "tier": "Adept", "cost": "", "description": "<p><b>Lore: Nature \u2014 Adept.</b> identify plants, tracks, and safe water; never poisoned by ignorance.</p>"}, "flags": {"blightmarch": {"skill": "Lore: Nature", "tier": "Adept"}}}
{"_id": "aDuApBm5CZo8AgGU", "name": "Beast-Lore", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: Nature", "tier": "Adept", "cost": "", "description": "<p><b>Lore: Nature \u2014 Adept.</b> know any animal's habits, range, and weaknesses on sight.</p>"}, "flags": {"blightmarch": {"skill": "Lore: Nature", "tier": "Adept"}}}
{"_id": "mGOwvVz39RrG4y8f", "name": "The Turning Season", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: Nature", "tier": "Master", "cost": "", "description": "<p><b>Lore: Nature \u2014 Master.</b> on a Masterstroke, predict an ecological shift before its signs are plain.</p>"}, "flags": {"blightmarch": {"skill": "Lore: Nature", "tier": "Master"}}}
{"_id": "9GYwDu7GtAvwr8EE", "name": "Keystone Sense", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Lore: Nature", "tier": "Master", "cost": "", "description": "<p><b>Lore: Nature \u2014 Master.</b> name what a region's ecology depends on, and what its removal would cascade into.</p>"}, "flags": {"blightmarch": {"skill": "Lore: Nature", "tier": "Master"}}}
{"_id": "oUq6W95TlxeX7xzz", "name": "Dead Reckoning", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Navigation", "tier": "Adept", "cost": "", "description": "<p><b>Navigation \u2014 Adept.</b> never lose your way in known regions; halve travel time on charted routes.</p>"}, "flags": {"blightmarch": {"skill": "Navigation", "tier": "Adept"}}}
{"_id": "AfzyqthBu847w4ZQ", "name": "Star-Read", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Navigation", "tier": "Adept", "cost": "", "description": "<p><b>Navigation \u2014 Adept.</b> fix your position and heading by night sky or coastline anywhere.</p>"}, "flags": {"blightmarch": {"skill": "Navigation", "tier": "Adept"}}}
{"_id": "LlBh88DvWXHu2tER", "name": "Uncharted", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Navigation", "tier": "Master", "cost": "", "description": "<p><b>Navigation \u2014 Master.</b> on a Masterstroke, map an unknown region well enough to grant +20 to those who follow.</p>"}, "flags": {"blightmarch": {"skill": "Navigation", "tier": "Master"}}}
{"_id": "8WbOtXsD7TfgbsTC", "name": "The Smuggler's Way", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Navigation", "tier": "Master", "cost": "", "description": "<p><b>Navigation \u2014 Master.</b> always know one route that avoids tolls, patrols, and witnesses.</p>"}, "flags": {"blightmarch": {"skill": "Navigation", "tier": "Master"}}}
