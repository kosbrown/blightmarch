{"_id": "HxspLXX6Wd6jOion", "name": "Run the Blockade", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Sailing", "tier": "Master", "cost": "", "description": "<p><b>Sailing \u2014 Master.</b> on a Masterstroke, slip a watched strait or harbor without inspection.</p>"}, "flags": {"blightmarch": {"skill": "Sailing", "tier": "Master"}}}
{"_id": "s8KQr4Rpf7C5mYn4", "name": "Master Mariner", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Sailing", "tier": "Master", "cost": "", "description": "<p><b>Sailing \u2014 Master.</b> your ship travels a full day faster than its make should allow.</p>"}, "flags": {"blightmarch": {"skill": "Sailing", "tier": "Master"}}}
{"_id": "aduNvXUY0wTHedcg", "name": "Cleaving Blow", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Heavy Weapons", "tier": "Adept", "cost": "", "description": "<p><b>Heavy Weapons \u2014 Adept.</b> on a Masterstroke, damage beyond what drops your target carries into an adjacent foe.</p>"}, "flags": {"blightmarch": {"skill": "Heavy Weapons", "tier": "Adept"}}}
{"_id": "Kcf6C44nD7HhykSd", "name": "Crushing Advance", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Heavy Weapons", "tier": "Adept", "cost": "", "description": "<p><b>Heavy Weapons \u2014 Adept.</b> 1 Stamina: on a hit, drive your foe back one band and follow; they cannot Riposte.</p>"}, "flags": {"blightmarch": {"skill": "Heavy Weapons", "tier": "Adept"}}}
{"_id": "mbOinYPxZGlpzRdP", "name": "Executioner's Arc", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Heavy Weapons", "tier": "Master", "cost": "", "description": "<p><b>Heavy Weapons \u2014 Master.</b> 2 Stamina: one Strike at \u221210 against two foes at Reach.</p>"}, "flags": {"blightmarch": {"skill": "Heavy Weapons", "tier": "Master"}}}
{"_id": "DX41b93ywmIPyFmB", "name": "Sundering Might", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Heavy Weapons", "tier": "Master", "cost": "", "description": "<p><b>Heavy Weapons \u2014 Master.</b> your Sunder notches ignore the shield entirely, striking the arm behind it.</p>"}, "flags": {"blightmarch": {"skill": "Heavy Weapons", "tier": "Master"}}}
{"_id": "A1UhXLTVE5jDFlrB", "name": "Serpent's Reply", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Light Weapons", "tier": "Adept", "cost": "", "description": "<p><b>Light Weapons \u2014 Adept.</b> your Ripostes cost no Stamina.</p>"}, "flags": {"blightmarch": {"skill": "Light Weapons", "tier": "Adept"}}}
