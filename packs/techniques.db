{"_id": "4ay1e7Dkz8Kb3Vb0", "name": "Read the Table", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Insight", "tier": "Master", "cost": "", "description": "<p><b>Insight \u2014 Master.</b> 1/scene, learn each present NPC's strongest immediate Want.</p>"}, "flags": {"blightmarch": {"skill": "Insight", "tier": "Master"}}}
{"_id": "kqDrMiR8INhZlhQD", "name": "Crack the Mask", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Insight", "tier": "Master", "cost": "", "description": "<p><b>Insight \u2014 Master.</b> on a Masterstroke, glimpse the Truth beneath an NPC's Mask (Ch. 2).</p>"}, "flags": {"blightmarch": {"skill": "Insight", "tier": "Master"}}}
{"_id": "LMHSjLoGRnwWA2fD", "name": "Hold the Line", "type": "technique", "img": "icons/skills/melee/hand-grip-sword-yellow.webp", "system": {"skill": "Leadership", "tier": "Adept", "cost": "", "description": "<p><b>Leadership \u2014 Adept.</b> your Rally restores Morale to all who hear it, not one ally.</p>"}, "flags": {"blightmarch": {"skill": "Leadership", "tier": "Adept"}}}
