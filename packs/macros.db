{"_id": "DDoEQ0YQe4qY9VZ3", "name": "Reckoning", "type": "script", "img": "icons/svg/d20-highlight.svg", "scope": "global", "command": "// Blightmarch \u2014 the Reckoning\n// Uses the selected token's actor if it has a sheet; otherwise prompts freely.\nconst actor = canvas.tokens.controlled[0]?.actor ?? game.user.character ?? null;\ngame.blightmarch.reckonDialog({ rating: 50, label: \"Reckoning\", actor });", "author": null, "ownership": {"default": 0}, "flags": {}}
{"_id": "q0jpY6xnCIeKtIVM", "name": "Growth Check", "type": "script", "img": "icons/skills/trades/academics-study-reading-book.webp", "scope": "global", "command": "// Blightmarch \u2014 Growth Check (downtime advancement)\n// d100 ABOVE the skill's current Rating improves it by +1d6.\nconst actor = canvas.tokens.controlled[0]?.actor ?? game.user.character ?? null;\nlet rating = 25;\nconst r = await new Promise(res => new Dialog({\n  title: \"Growth Check\",\n  content: `<p>Enter the skill's current Rating:</p><input type=\"number\" id=\"gr\" value=\"25\" style=\"width:100%\">`,\n  buttons: { ok: { label: \"Roll\", callback: h => res(Number(h.find('#gr').val())) } },\n  default: \"ok\"\n}).render(true));\ngame.blightmarch.growthCheck({ rating: r, label: \"Growth Check\", actor });", "author": null, "ownership": {"default": 0}, "flags": {}}
{"_id": "3fVZIFfNCjtYPcTH", "name": "Add Ash", "type": "script", "img": "icons/magic/unholy/silhouette-robe-evil-power.webp", "scope": "global", "command": "// Blightmarch \u2014 Add Ash to the selected character\nconst actor = canvas.tokens.controlled[0]?.actor;\nif (!actor || actor.type !== \"character\") return ui.notifications.warn(\"Select a character token.\");\nconst cur = actor.system.ash.value ?? 0;\nconst thr = actor.system.derived.ashThreshold ?? actor.system.attributes.wil.value;\nconst next = cur + 1;\nawait actor.update({ \"system.ash.value\": next });\nif (next >= thr) ui.notifications.error(`${actor.name} is BLIGHTED \u2014 add a Brand (Marks of the Seam) and clear Ash to 0.`);\nelse ui.notifications.info(`${actor.name}: Ash ${next}/${thr}.`);", "author": null, "ownership": {"default": 0}, "flags": {}}
